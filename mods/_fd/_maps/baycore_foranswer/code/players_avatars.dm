	setup_name = "Еmilio Dena"
	setup_desc = "Эмилио из семьи фермеров. Он с мехами на ты с самого детства. \
	Все-таки в мирной жизни тяжелая техника - незаменимый инструмент в любой тяжелой работе! \
	Может быть, его 'Миротворец' не самый бронированный, не самый технологичный и даже не самый убойный из всех, \
	но зато - самый надежный. Надежность - вот что ценит Эми больше всего. И да, он лидер вашего отряда!"
	see_in_dark = 8
	icon = 'mods/_fd/_maps/baycore_foranswer/icons/pilots/pilots_list.dmi'
