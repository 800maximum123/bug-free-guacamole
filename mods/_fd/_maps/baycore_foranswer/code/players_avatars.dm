/mob/living/carbon/human/pilot/krass
	setup_name = "Krass 'Flux' Folder"
	setup_desc = "Родом с Каллисто. В юности работал на ледокольных станциях — механику освоил раньше, \
	чем учился читать схемы. Призван по ускоренной технической программе ЦПСС во время эскалации конфликта с Восхождением. \
	Боевого опыта — ноль, инженерного — тонна. Своего 'Маррота' собрал буквально из остатков трёх списанных моделей. \
	После гибели инженера-супервайзера остался один из немногих, кто может держать технику в боевом состоянии — хоть скотчем и молитвой."
	see_in_dark = 8
	icon = 'mods/_fd/_maps/baycore_foranswer/icons/pilots/wide_pilots_list.dmi'
	icon_state = "krass"

	icon_state_setup = "krass"

