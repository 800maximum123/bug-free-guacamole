	note_info = {"В <span style="color: yellow;">████-м</span>(т.е. в текущем) году экипаж корабля SFMV 'Kitsune' находит Факел в поясе астероидов. Перейдя под командование Франчески Бернулли, 'Факел' берёт курс в сторону границы Скреллианской Империи, поскольку больше искать помощи, банально, негде..."}

