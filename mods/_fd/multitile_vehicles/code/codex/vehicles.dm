/datum/codex_entry/vehicle
	associated_paths = list(/obj/vehicles)
	lore_text = "Basic ground vehicles are still very widely used due their cheapness and compactness compared to massive space ships and shuttles, taking massive array of roles in both civilian and military applications."
	mechanics_text = "Click to enter the vehicle. <br>\
	Click while inside to swap seats. <br>\
	Click as DRIVER to honk the horn. <br>\
	Click with an item in hand to put it into the storage compartment. <br>\
	Click with an ACTIVE GRAB to put people inside. <br>\
	Vehicles can have 5 different seats: Driver - controls the vehicle, Commander - usually a front seat of the vehicle, Gunner - controls the vehicle turret, Passenger - usually no controls, Interior - special state for people in the mapped interior of the vehicle if it has one. <br>\
	Most of the vehicle controls are in a verb-panel on top-right corner of the screen."
	antag_text = "Nothing hits like a truck, then well, a truck! Running people over with vehicles is a viable way to murder them."
