/obj/overmap/simulated_ship/scg/stealth_rockfish
	name = "Rockfish-Class Stealth Craft"
	desc = "A small-size speedy vessel are used for sensitive missions and covert operations. Something between Corvette and Patrolcraft"
	icon = 'mods/_fd/ai_overmap_objects/icons/scg/sfv32.dmi'
	icon_state = "lexington"
	moving_state = "lexington_moving"
	characteristic = new /datum/ship_characteristic/scg/stealth_rockfish()

/datum/ship_characteristic/scg/stealth_rockfish
	max_health = 22500
	max_shield = 10000
	shield_regen_speed = 4 *(1 SECOND)
	vessel_mass = 55000
	vessel_size = SHIP_SIZE_SMALL
	max_speed = 25*(3 SECOND) //750
	min_targeted_distance_to_target = 2
	max_targeted_distance_to_target = 2
	sensors_range = 15
	ai_enabled = FALSE // We need that for one-mission

/datum/ship_characteristic/scg/stealth_rockfish/New()
	cannons = list(
		"minigun_1" = list("type" = /obj/machinery/computer/ship/ship_weapon/minigun, "accurace" = 80, "damage" = 0),
		"minigun_2" = list("type" = /obj/machinery/computer/ship/ship_weapon/minigun, "accurace" = 80, "damage" = 0),
		"minigun_3" = list("type" = /obj/machinery/computer/ship/ship_weapon/minigun, "accurace" = 80, "damage" = 0),
	)

	ammo = list(
		"minigun_ammo" = list("type" = /obj/item/ammo_magazine/ammobox/minigun, "ammount" = 21),
	)

	..()
